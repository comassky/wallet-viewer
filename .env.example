# Copy to .env and provide an account-level PUBLIC key. Never use an xprv or seed.
# Demo mode serves synthetic data for screenshots/previews; WALLET_XPUB is then optional.
WALLET_DEMO=false
WALLET_XPUB=
WALLET_NETWORK=mainnet
WALLET_SCRIPT_TYPE=auto
WALLET_GAP_LIMIT=20
# History scan cap per chain; increase to account for funds on a next receive
# address beyond the cap (watched for changes, but not scanned for history).
WALLET_MAX_ADDRESSES=200
# Wallet cache is event-driven, in-memory and instance-local; no TTL setting.
ELECTRUM_HOST=electrum.blockstream.info
ELECTRUM_PORT=50002
ELECTRUM_SSL=true
ELECTRUM_REQUEST_TIMEOUT=30s

# Logging. LOG_LEVEL controls the application (com.comassky.wallet) category.
# ROOT_LOG_LEVEL sets the global level; use DEBUG for full diagnostics such as
# native/GraalVM connection issues to Electrum (low-level network/TLS included).
LOG_LEVEL=INFO
ROOT_LOG_LEVEL=INFO

# Docker Compose: local build by default, or an existing GHCR image.
WALLET_VIEWER_IMAGE=wallet-viewer:local
WALLET_VIEWER_PORT=8080